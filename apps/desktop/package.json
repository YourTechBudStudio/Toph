{
  "name": "@toph/desktop",
  "version": "0.0.6",
  "private": true,
  "description": "Toph is a modern dictation software",
  "author": "YourTechBud <noorain@yourtechbud.studio>",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "pnpm run rebuild:native && pnpm --workspace-root run icons:app && electron-vite build && pnpm run check:main-bundle",
    "check:main-bundle": "node --check out/main/index.js",
    "dev": "pnpm --workspace-root run icons:app && cross-env TOPH_DATA_DIRECTORY=../../.toph ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dist": "pnpm run build && electron-builder",
    "dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "pack": "pnpm run build && electron-builder --dir",
    "preview": "pnpm --workspace-root run icons:app && cross-env TOPH_DATA_DIRECTORY=../../.toph ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "test:clipboard": "node --experimental-strip-types --test test/clipboard-*.test.ts",
    "test:dictation": "node --experimental-strip-types --test test/dictation-*.test.ts",
    "test:paths": "node --experimental-strip-types --test test/paths.test.ts",
    "test:polish": "node --experimental-strip-types --test test/polish/*.test.ts",
    "test:segmentation": "node --experimental-strip-types --test test/segmentation/*.test.ts",
    "test:settings": "node --experimental-strip-types --test test/settings/*.test.ts",
    "test:shortcuts": "node --experimental-strip-types --test test/shortcuts/*.test.ts",
    "test:updater": "node --experimental-strip-types --test test/updater/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@toph/desktop-contracts": "workspace:*",
    "@toph/desktop-ui": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
