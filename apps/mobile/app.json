{
  "expo": {
    "name": "Toph",
    "slug": "toph",
    "version": "0.0.8",
    "icon": "../../assets/logo.png",
    "scheme": "toph",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#24273a",
