<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- ${appLabel} is the app label placeholder from plugins/dev-variant.ts: "Toph" in release,
         "Toph Dev" in debug, so the keyboard is "Toph Voice" or "Toph Dev Voice". -->
    <service
      android:name="studio.yourtechbud.toph.keyboard.TophKeyboardService"
      android:exported="true"
      android:label="${appLabel} Voice"
      android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/toph_keyboard_method" />
    </service>
  </application>
</manifest>
