{
  "name": "@toph/mobile",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "android": "pnpm --workspace-root run icons:app && expo run:android --app-id studio.yourtechbud.toph.dev",
    "android:prebuild": "pnpm --workspace-root run icons:app && expo prebuild --platform android",
    "build": "expo export --platform android",
    "release:android": "pnpm --workspace-root run icons:app && expo run:android --variant release --app-id studio.yourtechbud.toph",
    "start": "expo start",
    "test": "node --test \"src/**/*.test.mjs\" \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project plugins/tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.1",
    "@toph/dictation-core": "workspace:*",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "uniwind": "1.12.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
